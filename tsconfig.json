{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "ES2020",
    "target": "ES2020",
    "types": ["jest"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },

  "include": ["src"],     
  "exclude": ["test"]     
}
